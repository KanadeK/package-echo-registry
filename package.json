{
  "name": "package-echo-registry",
  "version": "0.1.0",
  "description": "Trace package and SDK changes to downstream consumers, examples, and migration tasks.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK <121669563+KanadeK@users.noreply.github.com>",
  "homepage": "https://kanadek.github.io/package-echo-registry/",
  "repository": {
    "type": "git",
    "url": "https://github.com/KanadeK/package-echo-registry.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/package-echo-registry/issues"
  },
  "keywords": [
    "api",
    "dependencies",
    "monorepo",
    "semver",
    "typescript"
  ],
  "files": [
    "dist-cli",
    "examples/fixture-monorepo",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "bin": {
    "package-echo": "./dist-cli/cli.js"
  },
  "scripts": {
    "analyze": "tsx src/cli/index.ts analyze",
    "benchmark": "npm run build && tsx scripts/benchmark.ts",
    "build": "npm run generate:demo && npm run typecheck && vite build",
    "build:cli": "node scripts/buildCli.mjs",
    "capture:screenshot": "npm run build && tsx scripts/captureScreenshot.ts",
    "ci:check": "node scripts/checkWorkflows.mjs",
    "demo": "tsx src/cli/index.ts demo --output dist-demo",
    "dev": "npm run generate:demo && vite",
    "docs:check": "node scripts/checkDocs.mjs",
    "format": "prettier --check \"**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:write": "prettier --write \"**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "generate:demo": "tsx scripts/generate-demo-report.ts",
    "lint": "eslint .",
    "package": "node scripts/packageRelease.mjs",
    "pretest:e2e": "npm run build",
    "preview": "vite preview",
    "release-check": "node scripts/releaseCheck.mjs",
    "secret:scan": "node scripts/secretScan.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/runE2E.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "validate:demo": "tsx src/cli/index.ts validate public/demo-report.json",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@primer/css": "22.3.0",
    "commander": "15.0.0",
    "fast-glob": "3.3.3",
    "graphology": "0.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "ts-morph": "28.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
