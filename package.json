{
  "name": "package-echo-registry",
  "version": "0.1.0",
  "description": "Trace package and SDK changes to downstream consumers, examples, and migration tasks.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK <121669563+KanadeK@users.noreply.github.com>",
  "homepage": "https://kanadek.github.io/package-echo-registry/",
  "repository": {
    "type": "git",
    "url": "https://github.com/KanadeK/package-echo-registry.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/package-echo-registry/issues"
  },
  "keywords": [
    "api",
    "dependencies",
    "monorepo",
    "semver",
    "typescript"
  ],
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "package-echo": "./dist-cli/cli.js"
  },
  "scripts": {
    "analyze": "tsx src/cli/index.ts analyze",
    "build": "npm run generate:demo && npm run typecheck && vite build",
    "demo": "tsx src/cli/index.ts demo --output dist-demo",
    "dev": "npm run generate:demo && vite",
    "format": "prettier --check \"**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "format:write": "prettier --write \"**/*.{css,html,js,json,md,mjs,ts,tsx,yaml,yml}\"",
    "generate:demo": "tsx scripts/generate-demo-report.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --pretty false",
    "validate:demo": "tsx src/cli/index.ts validate public/demo-report.json",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@primer/css": "22.3.0",
    "commander": "15.0.0",
    "fast-glob": "3.3.3",
    "graphology": "0.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "ts-morph": "28.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/adm-zip": "0.5.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "adm-zip": "0.6.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
